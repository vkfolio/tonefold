"""FLVSTX Import — pulls the last export written by the FLVSTX plugin into the open piano roll.

The plugin writes %LOCALAPPDATA%\FLVSTX\export\latest.json:
{
  "ppq": 960,
  "tracks": [
    {"name": "Chords", "notes": [{"pitch": 60, "start": 0, "len": 960, "vel": 0.8, "color": 0}, ...]},
    ...
  ]
}
Times are ticks at the file's PPQ; they are rescaled to FL's PPQ here.
"""
import json
import os

import flpianoroll as flp

EXPORT_PATH = os.path.join(os.environ.get("LOCALAPPDATA", ""), "FLVSTX", "export", "latest.json")


def _load():
    try:
        with open(EXPORT_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:  # noqa: BLE001
        return {"error": str(e), "ppq": 960, "tracks": []}


def createDialog():
    data = _load()
    names = [t.get("name", "Track %d" % i) for i, t in enumerate(data.get("tracks", []))]
    desc = "Reads " + EXPORT_PATH
    if "error" in data:
        desc += "\n\nCould not read export: " + data["error"]
    form = flp.ScriptDialog("FLVSTX Import", desc)
    form.addInputCombo("Track", names + ["All tracks"], 0 if names else 0)
    form.addInputCheckbox("Replace existing notes", False)
    form.addInputCheckbox("Place at timeline selection start", True)
    form.addInputKnobInt("Transpose (semitones)", 0, -24, 24)
    return form


def apply(form):
    data = _load()
    tracks = data.get("tracks", [])
    if not tracks:
        return
    src_ppq = float(data.get("ppq", 960))
    scale = flp.score.PPQ / src_ppq
    choice = int(form.getInputValue("Track"))
    chosen = tracks if choice >= len(tracks) else [tracks[choice]]
    transpose = int(form.getInputValue("Transpose (semitones)"))

    if form.getInputValue("Replace existing notes"):
        flp.score.clearNotes(True)

    offset = 0
    if form.getInputValue("Place at timeline selection start"):
        sel = flp.score.getTimelineSelection()
        if sel and sel[0] >= 0:
            offset = sel[0]

    for ti, track in enumerate(chosen):
        for n in track.get("notes", []):
            note = flp.score.getDefaultNoteProperties().clone()
            note.number = max(0, min(131, int(n["pitch"]) + transpose))
            note.time = int(round(n["start"] * scale)) + offset
            note.length = max(1, int(round(n["len"] * scale)))
            note.velocity = max(0.0, min(1.0, float(n.get("vel", 0.8))))
            note.color = int(n.get("color", ti)) % 16
            flp.score.addNote(note)
